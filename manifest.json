{
  "manifest_version": 3,
  "name": "Teletalk Job FastFiller - BD Govt Jobs",
  "version": "1.0.0",
  "description": "Universal 1-click autofiller for Bangladesh Government job applications on Teletalk portals (fri, bpsc, dpe, alljobs, etc.).",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.teletalk.com.bd/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Teletalk Job FastFiller"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.teletalk.com.bd/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
